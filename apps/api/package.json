{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "mikro-orm": "vite-node node_modules/@mikro-orm/cli/cli.js",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "schema:update": "pnpm mikro-orm schema:update --run",
    "schema:drop": "pnpm mikro-orm schema:drop --run",
    "seed": "pnpm mikro-orm seeder:run",
    "schema:fresh": "pnpm mikro-orm schema:fresh --seed -r"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.0",
    "@mikro-orm/core": "^7.1.1",
    "@mikro-orm/decorators": "^7.1.1",
    "@mikro-orm/postgresql": "^7.1.1",
    "bcrypt": "^6.0.0",
    "fastify": "^4.26.2",
    "reflect-metadata": "^0.2.2",
    "shared": "workspace:*",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.1.1",
    "@types/bcrypt": "^6.0.0",
    "@types/uuid": "^9.0.8",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vite-node": "~5.3.0"
  }
}
